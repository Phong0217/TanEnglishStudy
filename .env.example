APP_NAME="English Center LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_APP_DAYS=14
LOG_AUTH_DAYS=30
LOG_ASSIGNMENT_DAYS=30
LOG_LESSON_DAYS=30
LOG_QUESTION_DAYS=30
LOG_AI_DAYS=30
LOG_IMPORT_DAYS=30
LOG_SUBMISSION_DAYS=30
LOG_GRADING_DAYS=30
LOG_QUEUE_DAYS=30
LOG_INTEGRATION_DAYS=30
LOG_ERROR_LEVEL=error
LOG_ERROR_DAYS=60

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=english_center_lms
DB_USERNAME=lms
DB_PASSWORD=lms

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=english-center
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

AI_PROVIDER=mock
AI_MODEL=gpt-5-mini
AI_API_KEY=
AI_TIMEOUT=60
AI_MAX_RETRIES=2
DOCUMENT_MAX_KB=20480

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6379
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=9001
FORWARD_MAIL_PORT=1025
FORWARD_MAILPIT_PORT=8025

VITE_APP_NAME="${APP_NAME}"
